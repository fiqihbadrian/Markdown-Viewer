{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "MarkdownViewer",
  "version": "1.2.1",
  "identifier": "com.fiqihbadrian.markdownviewer",
  "build": {
    "frontendDist": "../src"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "label": "main",
        "title": "MarkdownViewer",
        "width": 1000,
        "height": 760,
        "minWidth": 600,
        "minHeight": 400,
        "dragDropEnabled": true
      }
    ],
    "security": {
      "csp": "default-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data: blob:"
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis", "deb", "appimage"],
    "icon": ["icons/icon.ico", "icons/icon.png", "icons/128x128.png", "icons/128x128@2x.png"],
    "category": "Productivity",
    "shortDescription": "Markdown viewer dan editor",
    "longDescription": "Buka, edit, dan ekspor file Markdown ke PDF dan PNG.",
    "fileAssociations": [
      {
        "ext": ["md", "markdown"],
        "name": "Markdown",
        "description": "Markdown file",
        "role": "Viewer"
      }
    ],
    "linux": {
      "deb": {
        "depends": ["libwebkit2gtk-4.1-0", "libgtk-3-0"]
      }
    },
    "windows": {
      "nsis": {
        "languages": ["English", "Indonesian"],
        "displayLanguageSelector": false,
        "installMode": "currentUser",
        "installerIcon": "icons/icon.ico",
        "headerImage": "../build/installerHeader.bmp",
        "sidebarImage": "../build/installerSidebar.bmp"
      }
    }
  }
}
